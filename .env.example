# Database (SQLite zero-friction local run; PostgreSQL-compatible)
DATABASE_URL="file:./dev.db"

# Session & JWT secret
JWT_SECRET="shopmate-super-secure-jwt-secret-key-kirana-2026"
NEXTAUTH_SECRET="shopmate-super-secure-jwt-secret-key-kirana-2026"

# Pure Local NLP Mode: 100% on-device, 0ms latency, zero external API keys needed!
LOCAL_NLP_ONLY="true"

# Optional Android/iOS-only local LLM. Suggested model: Qwen2.5-0.5B-Instruct
# in Q4_K_M GGUF (~400 MB). The app works without it.
MOBILE_LLM_ENABLED="false"
MOBILE_LLM_MODEL="Qwen2.5-0.5B-Instruct-Q4_K_M.gguf"
